# ML sidecar — конфигурация (всё через env, не через код — требование жюри).
# Скопируйте в .env и правьте. Все значения имеют безопасные дефолты
# в personal_predlozhenie/config.py.

# --- Ключевая ставка, % (вилка ставки = KEY_RATE + спред грейда + спред продукта). ---
# Сверить с фактической ключевой ставкой на день защиты!
ML_KEY_RATE=17.0

# --- Синтетика / обучение ---
ML_SEED=42
ML_N_RECORDS=15000
# объём истории взаимодействий «роль ЛПР × формат» для модели склонности
ML_LPR_N_RECORDS=12000
# Каталог артефактов (модели/метрики/датасеты/демо-профили). Пусто = ./artifacts
ML_ARTIFACTS_DIR=

# --- Open-weight LLM (опционально; по умолчанию ВЫКЛ — работает на шаблонах) ---
# Провайдер конфигурируемый: любой OpenAI-совместимый endpoint (Ollama / vLLM).
ML_LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
ML_LLM_TIMEOUT_S=8
ML_LLM_MAX_TOKENS=220
ML_LLM_TEMPERATURE=0.4
